# OfficeBite Backend Local Environment Variables
# Copy this file to .env or set these in your local environment
DB_URL=jdbc:mysql://localhost:3306/officebite?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
PORT=8081

# JWT Authentication Configuration
# Provide a 256-bit (32+ character) secure secret for HMAC-SHA256 signing
JWT_SECRET=your_minimum_32_characters_random_secret_signing_key_here!
JWT_EXPIRATION_MS=86400000

# Optional: Initial Privileged Account Bootstrap
# Set these to securely provision initial kitchen staff and admin accounts on startup
BOOTSTRAP_STAFF_EMAIL=staff@officebite.com
BOOTSTRAP_STAFF_PASSWORD=your_secure_staff_password_here
BOOTSTRAP_STAFF_NAME=Kitchen Staff
BOOTSTRAP_STAFF_EMPLOYEE_ID=STAFF-01

BOOTSTRAP_ADMIN_EMAIL=admin@officebite.com
BOOTSTRAP_ADMIN_PASSWORD=your_secure_admin_password_here
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_EMPLOYEE_ID=ADMIN-01


